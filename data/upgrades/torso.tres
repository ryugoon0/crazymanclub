[gd_resource type="Resource" script_class="UpgradeData" load_steps=3 format=3]

[ext_resource type="Script" path="res://schema/upgrade_data.gd" id="1"]
[ext_resource type="Script" path="res://schema/stat_modifier.gd" id="2"]

[sub_resource type="Resource" id="mod_hp"]
script = ExtResource("2")
