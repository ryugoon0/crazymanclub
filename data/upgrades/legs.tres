[gd_resource type="Resource" script_class="UpgradeData" load_steps=4 format=3]

[ext_resource type="Script" path="res://schema/upgrade_data.gd" id="1"]
[ext_resource type="Script" path="res://schema/stat_modifier.gd" id="2"]

[sub_resource type="Resource" id="mod_speed"]
script = ExtResource("2")
stat = &"move_speed"
op = 1
value = 1.08

[sub_resource type="Resource" id="mod_dash"]
script = ExtResource("2")
stat = &"dash_cooldown"
op = 1
value = 0.85

[resource]
script = ExtResource("1")
id = &"legs"
display_name_key = "BIO_LEGS_NAME"
slot = 2
max_level = 3
costs = PackedInt32Array(1800, 3000, 5000)
modifiers_per_level = Array[ExtResource("2")]([SubResource("mod_speed"), SubResource("mod_dash")])
